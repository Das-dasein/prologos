{
  "name": "prolog-agent-memory",
  "private": true,
  "scripts": {
    "chat": "node chat.js",
    "chat:api": "LLM_PROVIDER=openai-api node chat.js",
    "demo": "node cli.js demo.pl",
    "reflect": "node memory-reflection.js",
    "reflect:agent": "node reflection-agent.js",
    "reflect:apply": "node reflection-apply.js",
    "elenchus": "node elenchus-cli.js",
    "ontology": "node ontology-server.js",
    "test": "node test.js && node test-ontology-harness.js && node test-elenchus.js && node test-registry-ingestion.js && node test-live-extraction.js && node test-trusted-proof-preflight.js && node test-trusted-proof-answering.js",
    "test:cdr-annotation": "node test-cdr-annotation.js",
    "test:cdr-gold": "node cdr-eval-harness.js --config .cdr/results/prolog-memory-eval-v0/eval-config-v1.json --dataset .cdr/datasets/dialogues-pilot-v1.jsonl --oracle .cdr/results/prolog-memory-eval-v0/pilot-oracle.json",
    "test:cdr-matrix": "node cdr-matrix-harness.js"
    ,"pilot": "node pilot-runner.js"
    ,"pilot:dashboard": "node pilot-dashboard.js"
    ,"test:pilot": "node test-pilot-runner.js"
    ,"test:pilot:preflight": "node test-live-v2-preflight.js"
    ,"eval:offline:v3": "node offline-eval-v3.js"
    ,"test:offline-eval:v3": "node test-offline-eval-v3.js"
    ,"test:offline-eval:schema": "node validate-offline-eval-v3.js"
    ,"test:cognitive-memory": "node test-cognitive-memory.js"
    ,"test:trusted-proof-preflight": "node test-trusted-proof-preflight.js"
    ,"test:trusted-proof-answering": "node test-trusted-proof-answering.js"
    ,"test:trusted-proof-live-candidate": "node test-trusted-proof-live-candidate.js"
    ,"test:cdr-receipt-intake": "node .cdr/waves/cognitive-proof-eval-v1/validate-receipt-intake-v1.js --self-test"
    ,"test:cdr-receipt-intake:v2": "node .cdr/waves/cognitive-proof-eval-v1/validate-receipt-intake-v2.js --self-test"
    ,"test:cdr-receipt-intake:v3": "node .cdr/waves/cognitive-proof-eval-v1/validate-receipt-intake-v3.js --self-test"
  },
  "dependencies": {
    "openai": "^7.9.0",
    "tau-prolog": "^0.3.4",
    "zod": "^4.5.4"
  }
}
