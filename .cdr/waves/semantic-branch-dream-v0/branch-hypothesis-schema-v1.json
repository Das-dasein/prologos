{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semantic-branch-dream-hypothesis-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "baseline_candidate_sha256", "hypotheses"],
  "properties": {
    "schema_version": { "type": "string", "const": "semantic-branch-dream-hypothesis-v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "baseline_candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hypotheses": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source_sentence_id", "source_quote", "candidate"],
        "properties": {
          "id": { "type": "string", "pattern": "^h[1-2]$" },
          "kind": { "enum": ["connector_interpretation", "predicate_alias", "missing_type_assumption"] },
          "source_sentence_id": { "type": "string", "pattern": "^s[0-9]+$" },
          "source_quote": { "type": "string", "minLength": 1 },
          "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["program", "query"],
            "properties": { "program": { "type": "string", "minLength": 1 }, "query": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
