{
  "schema_version": "ontology-layer-v1",
  "identity": {
    "name": "universal_core",
    "version": "1.0.0"
  },
  "description": "Shared categories and identity relations available to every agent. This is a meta-ontology, not a collection of personal facts.",
  "types": [
    { "name": "entity", "parent": null, "meaning": "anything that can be identified" },
    { "name": "class", "parent": "entity", "meaning": "a category of entities" },
    { "name": "agent", "parent": "entity", "meaning": "an entity capable of action" },
    { "name": "person", "parent": "agent", "meaning": "a human agent" },
    { "name": "organization", "parent": "agent", "meaning": "an organized collective agent" },
    { "name": "place", "parent": "entity", "meaning": "a spatial entity" },
    { "name": "thing", "parent": "entity", "meaning": "a material or conceptual object" },
    { "name": "activity", "parent": "entity", "meaning": "an activity or practice" },
    { "name": "information_object", "parent": "thing", "meaning": "a symbolic or informational object" },
    { "name": "value", "parent": "information_object", "meaning": "an atomic literal represented as a safe Prolog atom" }
  ],
  "predicates": [
    {
      "name": "instance_of",
      "arity": 2,
      "kind": "base",
      "argument_types": ["entity", "class"],
      "meaning": "an entity is an instance of a class"
    },
    {
      "name": "subclass_of",
      "arity": 2,
      "kind": "base",
      "argument_types": ["class", "class"],
      "meaning": "one class is a specialization of another class"
    },
    {
      "name": "same_as",
      "arity": 2,
      "kind": "base",
      "argument_types": ["entity", "entity"],
      "meaning": "two identifiers refer to the same entity"
    },
    {
      "name": "has_name",
      "arity": 2,
      "kind": "base",
      "argument_types": ["entity", "value"],
      "meaning": "an entity has a stated name"
    }
  ]
}
