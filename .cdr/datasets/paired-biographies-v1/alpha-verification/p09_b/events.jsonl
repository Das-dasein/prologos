{"seq":11,"id":"e11","previous":"da18a1c1161fd70fb95c8e707bc869a69916e971400837a323cbb967f7430f4d","at":4,"type":"source","payload":{"text":"Доступ к ресурсу elm разрешён только от момента 4 до момента 12 включительно.","kind":"user"},"sha256":"d6e43c15f4be20fe9e7b6859828e1dc53cdcf0703f5da29b5d9caab808db563d"}
