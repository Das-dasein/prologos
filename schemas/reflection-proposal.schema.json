{
  "type": "object",
  "properties": {
    "schema_version": { "const": "reflection-proposal-v1" },
    "actions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          { "type": "object", "properties": { "action": { "const": "mark_duplicate" }, "canonical_id": { "type": "string" }, "duplicate_id": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } }, "required": ["action", "canonical_id", "duplicate_id", "reason"], "additionalProperties": false },
          { "type": "object", "properties": { "action": { "const": "propose_alias" }, "from": { "type": "string" }, "to": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } }, "required": ["action", "from", "to", "reason"], "additionalProperties": false },
          { "type": "object", "properties": { "action": { "const": "propose_revision" }, "new_id": { "type": "string" }, "old_id": { "type": "string" }, "relation": { "enum": ["replaces", "confirms"] }, "reason": { "type": "string", "minLength": 1 } }, "required": ["action", "new_id", "old_id", "relation", "reason"], "additionalProperties": false },
          { "type": "object", "properties": { "action": { "const": "review" }, "assertion_id": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } }, "required": ["action", "assertion_id", "reason"], "additionalProperties": false }
        ]
      }
    }
  },
  "required": ["schema_version", "actions"],
  "additionalProperties": false
}
