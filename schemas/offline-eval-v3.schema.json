{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offline-eval-v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "evaluator_version", "run_id", "run_binding", "replay_status", "evidence_boundary", "input_hashes", "source_snapshot", "frozen_inputs", "historical_metadata", "conditions", "limits"],
  "properties": {
    "schema_version": {"const": "offline-eval-v3"}, "artifact_kind": {"const": "offline_replay"}, "evaluator_version": {"type": "string"}, "run_id": {"type": "string"},
    "run_binding": {"type": "object", "required": ["expected_run_id", "manifest_run_id", "verified"], "additionalProperties": false, "properties": {"expected_run_id": {"type": "string"}, "aggregate_run_id": {"type": ["string", "null"]}, "manifest_run_id": {"type": "string"}, "verified": {"const": true}}},
    "replay_status": {"enum": ["computed", "indeterminate"]}, "evidence_boundary": {"const": "post_hoc_computed_historical_replay"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "source_snapshot": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "frozen_inputs": {"type": "object"}, "historical_metadata": {"type": "object"}, "conditions": {"type": "array"}, "limits": {"type": "array", "items": {"type": "string"}}
  }
}
