{
  "type": "object",
  "properties": {
    "schema_version": { "const": "semantic-dialogue-v1" },
    "registry": {
      "type": "object",
      "required": ["version", "declarations"],
      "properties": {
        "version": { "const": "semantic-predicate-registry-v1" },
        "declarations": { "type": "array", "minItems": 1, "maxItems": 100 }
      },
      "additionalProperties": false
    },
    "entities": { "type": "array", "maxItems": 100 },
    "assertions": { "type": "array", "maxItems": 100 }
  },
  "required": ["schema_version", "registry", "entities", "assertions"],
  "additionalProperties": false
}
