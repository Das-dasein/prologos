{"seq":11,"id":"e11","previous":"1607e43b93d4068f98471771e958886119faa9f73d64fc61f78773dcde79b145","at":4,"type":"source","payload":{"text":"Доступ к ресурсу elm разрешён только от момента 4 до момента 12 включительно.","kind":"user"},"sha256":"79aec0044176859eb9594704e228e6cfb26cf6d03d491ec06da3c4e8aa4661cb"}
